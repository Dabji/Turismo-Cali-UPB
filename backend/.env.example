# ==========================================
# CONFIGURACIÓN DEL SERVIDOR
# ==========================================
NODE_ENV=development
PORT=4000
API_PREFIX=/api

# ==========================================
# BASE DE DATOS - MySQL
# ==========================================
DATABASE_URL="mysql://root:password@localhost:3306/turismo_cali"
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=turismo_cali

# ==========================================
# JWT - Autenticación
# ==========================================
JWT_SECRET=cambiar_este_secreto_en_produccion_abc123
JWT_EXPIRES_IN=8h

# ==========================================
# LDAP - Directorio Activo
# ==========================================
LDAP_URL=ldap://192.168.1.10:389
LDAP_BIND_DN=cn=admin,dc=turismocali,dc=com
LDAP_BIND_PASSWORD=ldap_password
LDAP_SEARCH_BASE=ou=usuarios,dc=turismocali,dc=com
LDAP_SEARCH_FILTER=(uid={{username}})

# ==========================================
# CORS
# ==========================================
CORS_ORIGIN=http://localhost:5173

# ==========================================
# LOGS
# ==========================================
LOG_LEVEL=info
LOG_DIR=./logs
